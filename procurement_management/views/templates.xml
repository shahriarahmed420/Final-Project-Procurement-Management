<odoo>
    <data>
        <template id="add_supplier_registration_button_homepage" inherit_id="website.layout" name="Add Supplier Registration Button to Homepage">
            <xpath expr="//main" position="inside">
                <t t-if="request.httprequest.path == '/'">
                    <div class="container text-center my-5">
                        <a href="/my/supplier" class="btn btn-primary btn-lg">Register as a Supplier</a>
                    </div>
                </t>
            </xpath>
        </template>

        <template id="supplier_page_template">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h1 class="text-center mb-4 text-uppercase text-primary">Supplier Registration</h1>
                    <div class="card shadow-sm rounded bg-white p-4">
                        <form method="POST" action="/my/supplier/check">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3 text-center">
                                <label class="form-label fw-bold fs-4 text-primary">Do you Sign in or Sign up?</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Next</button>
                        </form>
                    </div>
                </div>
            </t>
        </template>

        <template id="supplier_mail_template">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h1 class="text-center mb-4 text-uppercase text-primary">Supplier Mail Check</h1>

                    <!-- Display Error Message -->
                    <t t-if="error">
                        <div class="alert alert-danger text-center" role="alert">
                            <t t-esc="error" />
                        </div>
                    </t>

                    <!-- Email Input Form -->
                    <div class="card shadow-sm rounded bg-white p-4">
                        <form method="POST" action="/my/supplier/check">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3 text-center">
                                <label class="form-label fw-bold fs-4 text-primary">Enter Your Email</label>
                                <input type="email" name="email" class="form-control mt-3" placeholder="Enter your email"/>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Next</button>
                        </form>
                    </div>
                </div>
            </t>
        </template>

        <template id="otp_verification_template">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h1 class="text-center mb-4 text-uppercase text-primary">OTP Verification</h1>

                    <t t-if="error">
                        <div class="alert alert-danger" role="alert">
                            <t t-esc="error" />
                        </div>
                    </t>
                    <t t-if="success">
                        <div class="alert alert-success" role="alert">
                            <t t-esc="success" />
                        </div>
                    </t>

                    <div class="card shadow-sm rounded bg-white p-4">
                        <!-- Form to Submit Email -->
                        <form method="POST" action="/my/otp/send">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control" placeholder="Enter your email"/>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Send OTP</button>
                        </form>

                        <!-- OTP Verification Section -->
                        <t t-if="show_otp_section">
                            <form method="POST" action="/my/otp/verify" class="mt-4">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="email" t-att-value="email"/>
                                <div class="mb-3">
                                    <label class="form-label">Enter OTP</label>
                                    <input type="text" name="otp" class="form-control" placeholder="Enter OTP"/>
                                </div>
                                <button type="submit" class="btn btn-success w-100 mt-2">Verify OTP</button>
                            </form>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <template id="supplier_registration_form_template">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h1 class="text-center mb-4 text-uppercase text-primary">Supplier Registration Form</h1>

                    <form id="multi-step-form" method="POST" action="/my/supplier/form/submit" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Step 1: Company Information -->
                        <div class="form-step" id="step-1">
                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="card-header bg-primary text-white text-center">
                                    <h3 class="mb-0">Section 1: Supplier Company Information</h3>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Company Name</label>
                                        <input type="text" name="company_name" class="form-control" placeholder="Enter Company Name" required=""/>
                                        <div class="invalid-feedback">Company Name is required.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Company Address</label>
                                        <input type="text" name="company_address" class="form-control" placeholder="Enter Company Address" required=""/>
                                        <div class="invalid-feedback">Company Address is required.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Company Type</label>
                                        <select name="company_type" class="form-select" required="">
                                            <option value="">Select your company type</option>
                                            <option value="sole_proprietorship">Sole Proprietorship</option>
                                            <option value="partnership">Partnership</option>
                                            <option value="llc">Limited Liability Company (LLC)</option>
                                            <option value="corporation">Corporation</option>
                                            <option value="s_corporation">S Corporation</option>
                                            <option value="cooperative">Cooperative</option>
                                            <option value="non_profit">Non-Profit Organization</option>
                                            <option value="government_agency">Government Agency</option>
                                            <option value="joint_venture">Joint Venture</option>
                                            <option value="holding_company">Holding Company</option>
                                            <option value="private_limited">Private Limited Company</option>
                                            <option value="public_limited">Public Limited Company</option>
                                        </select>
                                        <div class="invalid-feedback">Company Type is required.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Company Logo</label>
                                        <input type="file" name="company_logo" class="form-control" />
                                    </div>
                                </div>

                                <h5 class="text-primary mb-3">Primary Contact</h5>
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" name="primary_contact_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="primary_contact_email" class="form-control" placeholder="Enter Email" required=""/>
                                    <div class="invalid-feedback">Email is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="primary_contact_phone" class="form-control" placeholder="Enter Phone Number" required=""/>
                                    <div class="invalid-feedback">Phone is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Address</label>
                                    <input type="text" name="primary_contact_address" class="form-control" placeholder="Enter Address"/>
                                </div>

                                <h5 class="text-primary mb-3">Financial Contact</h5>
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" name="finance_contact_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="finance_contact_email" class="form-control" placeholder="Enter Email" required=""/>
                                    <div class="invalid-feedback">Email is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="finance_contact_phone" class="form-control" placeholder="Enter Phone Number" required=""/>
                                    <div class="invalid-feedback">Phone is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Address</label>
                                    <input type="text" name="finance_contact_address" class="form-control" placeholder="Enter Phone Address"/>
                                </div>

                                <h5 class="text-primary mb-3">Authorized Contact</h5>
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" name="authorized_contact_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="authorized_contact_email" class="form-control" placeholder="Enter Email" required=""/>
                                    <div class="invalid-feedback">Email is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="authorized_contact_phone" class="form-control" placeholder="Enter Phone Number" required=""/>
                                    <div class="invalid-feedback">Phone is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Address</label>
                                    <input type="text" name="authorized_contact_address" class="form-control" placeholder="Enter Phone Address"/>
                                </div>

                                <h5 class="text-primary mb-3">Additional Information</h5>
                                <div class="mb-3">
                                    <label class="form-label">Trade License Number</label>
                                    <input type="text" name="trade_license_no" class="form-control" placeholder="Enter Trade License Number:"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Commencement Date</label>
                                    <input type="email" name="commencement_date" class="form-control" placeholder="Enter Commencement Date"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Expiry Date</label>
                                    <input type="text" name="expiry_date" class="form-control" placeholder="Enter Expiry Date"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Tax Identification Number (TIN)</label>
                                    <input type="text" name="tax_id_num" class="form-control" placeholder="Enter Tax Identification Number (TIN)"/>
                                </div>
                            </div>

                            <button type="button" class="btn btn-primary" id="next-1">Next</button>
                        </div>

                        <!-- Step 2: Financial Information -->
                        <div class="form-step" id="step-2" style="display: none;">
                            <h3 class="text-primary text-center">Section 2: Financial Information</h3>
                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Bank Name</label>
                                    <input type="text" name="bank_name" class="form-control" placeholder="Enter Bank Name" required=""/>
                                    <div class="invalid-feedback">Bank Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Bank Address</label>
                                    <input type="text" name="bank_address" class="form-control" placeholder="Enter Bank Address" required=""/>
                                    <div class="invalid-feedback">Bank Address is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Bank SWIFT Code</label>
                                    <input type="text" name="bank_swift_code" class="form-control" placeholder="Enter Bank SWIFT Code" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Account Name</label>
                                    <input type="text" name="account_name" class="form-control" placeholder="Enter Account Name" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Account Number</label>
                                    <input type="text" name="account_number" class="form-control" placeholder="Enter Account Number" required=""/>
                                    <div class="invalid-feedback">Account Number is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">IBAN</label>
                                    <input type="text" name="iban" class="form-control" placeholder="Enter IBAN" />
                                </div>
                            </div>

                            <button type="button" class="btn btn-secondary" id="prev-2">Previous</button>
                            <button type="button" class="btn btn-primary" id="next-2">Next</button>
                        </div>

                        <!-- Step 3: Previous Client References -->
                        <div class="form-step" id="step-3" style="display: none;">
                            <h3 class="text-primary text-center">Section 3: Previous Client References</h3>
                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Client-1 Name</label>
                                    <input type="text" name="client_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-1 Email</label>
                                    <input type="text" name="client_email" class="form-control" placeholder="Enter Name" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-1 Phone</label>
                                    <input type="text" name="client_phone" class="form-control" placeholder="Enter Name" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-1 Address</label>
                                    <input type="text" name="client_address" class="form-control" placeholder="Enter Name" />
                                </div>
                            </div>

                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Client-2 Name</label>
                                    <input type="text" name="client_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-2 Email</label>
                                    <input type="text" name="client_email" class="form-control" placeholder="Enter Email" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-2 Phone</label>
                                    <input type="text" name="client_phone" class="form-control" placeholder="Enter Phone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-2 Address</label>
                                    <input type="text" name="client_address" class="form-control" placeholder="Enter Address" />
                                </div>
                            </div>

                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Client-3 Name</label>
                                    <input type="text" name="client_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-3 Email</label>
                                    <input type="text" name="client_email" class="form-control" placeholder="Enter Email" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-3 Phone</label>
                                    <input type="text" name="client_phone" class="form-control" placeholder="Enter Phone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-3 Address</label>
                                    <input type="text" name="client_address" class="form-control" placeholder="Enter Address" />
                                </div>
                            </div>

                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Client-4 Name</label>
                                    <input type="text" name="client_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-4 Email</label>
                                    <input type="text" name="client_email" class="form-control" placeholder="Enter Email" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-4 Phone</label>
                                    <input type="text" name="client_phone" class="form-control" placeholder="Enter Phone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-4 Address</label>
                                    <input type="text" name="client_address" class="form-control" placeholder="Enter Address" />
                                </div>
                            </div>

                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Client-5 Name</label>
                                    <input type="text" name="client_name" class="form-control" placeholder="Enter Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-5 Email</label>
                                    <input type="text" name="client_email" class="form-control" placeholder="Enter Email" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-5 Phone</label>
                                    <input type="text" name="client_phone" class="form-control" placeholder="Enter Phone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Client-5 Address</label>
                                    <input type="text" name="client_address" class="form-control" placeholder="Enter Address" />
                                </div>
                            </div>

                            <button type="button" class="btn btn-secondary" id="prev-3">Previous</button>
                            <button type="button" class="btn btn-primary" id="next-3">Next</button>
                        </div>

                        <!-- Step 4: Certifications -->
                        <div class="form-step" id="step-4" style="display: none;">
                            <h3 class="text-primary text-center">Section 4: Certifications</h3>
                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="mb-3">
                                    <label class="form-label">Certification Name</label>
                                    <input type="text" name="certification_name" class="form-control" placeholder="Enter Certification Name"/>
                                    <div class="invalid-feedback">Certification Name is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Certification Number</label>
                                    <input type="text" name="certificate_number" class="form-control" placeholder="Enter Certification Name"/>
                                    <div class="invalid-feedback">Certification Number is required.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Certifying Body</label>
                                    <input type="text" name="certifying_body" class="form-control" placeholder="Enter Certifying Body"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Award Date</label>
                                    <input type="text" name="award_date" class="form-control" placeholder="Enter Award Date"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Expiry Date</label>
                                    <input type="text" name="certificate_expiry_date" class="form-control" placeholder="Enter Expiry Date"/>
                                </div>
                            </div>

                            <button type="button" class="btn btn-secondary" id="prev-4">Previous</button>
                            <button type="button" class="btn btn-primary" id="next-4">Next</button>
                        </div>

                        <div class="form-step" id="step-5" style="display: none;">
                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <div class="card-header bg-primary text-white text-center">
                                    <h3 class="mb-0">Section 5: Document Submission</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <!-- Left Column -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Trade License / Business Registration</label>
                                            <input type="file" name="trade_license_business_registration" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Certificate of Incorporation</label>
                                            <input type="file" name="certificate_of_incorporation" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Certificate of Good Standing</label>
                                            <input type="file" name="certificate_of_good_standing" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Establishment Card</label>
                                            <input type="file" name="establishment_card" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">VAT / TAX Certificate</label>
                                            <input type="file" name="vat_tax_certificate" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Memorandum of Association</label>
                                            <input type="file" name="memorandum_of_association" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Identification Document for Authorized Person</label>
                                            <input type="file" name="identification_document_for_authorized_person" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Bank Letter indicating Bank Account</label>
                                            <input type="file" name="bank_letter_indicating_bank_account" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Past 2 Years Audited Financial Statements</label>
                                            <input type="file" name="past_2_years_audited_financial_statements" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Other Certifications</label>
                                            <input type="file" name="other_certifications" class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                                <h4 class="text-primary mb-3">Declaration</h4>

                                <div class="mb-3">
                                    <label class="form-label">Declaration Statement</label>
                                    <p name="declaration_statement" class="form-control">
                                        I confirm that all information and documents supplied are true and accurate to the best of my
                                        knowledge, and I understand that this information may be considered material in the evaluation of
                                        quotations, bids, and/or proposals.
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Name of Signatory</label>
                                    <input type="text" name="name_of_signatory" class="form-control" placeholder="Enter Signatory Name" required=""/>
                                    <div class="invalid-feedback">Name is required.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Authorized Signatory Role</label>
                                    <input type="text" name="authorized_signatory" class="form-control" placeholder="Enter Signatory Role" required=""/>
                                    <div class="invalid-feedback">Role is required.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Company Stamp &amp; Date</label>
                                    <input type="file" name="company_stamp" class="form-control" required="" />
                                    <div class="invalid-feedback">Company Stamp is required.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Submission Date</label>
                                    <input type="date" name="submission_date" class="form-control" t-att-value="current_date" required=""/>
                                    <div class="invalid-feedback">Date is required.</div>
                                </div>
                            </div>

                            <button type="button" class="btn btn-secondary" id="prev-5">Previous</button>
                            <button type="submit" class="btn btn-primary" id="submit-form">Submit</button>
                        </div>
                    </form>
                </div>
                <script src="/procurement_management/static/src/js/form_navigation.js">Navigation Script</script>
            </t>
        </template>

        <template id="supplier_registration_success_template">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h1 class="text-center text-success">Registration Successful!</h1>
                    <p class="text-center">Thank you for registering. We will review your application and get back to you shortly.</p>
                </div>
            </t>
        </template>

    </data>
</odoo>