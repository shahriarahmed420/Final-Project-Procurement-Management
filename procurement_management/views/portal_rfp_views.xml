<odoo>
    <template id="portal_my_home_otp" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_vendor_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                <t t-set="title">RFPs</t>
                <t t-set="text">Formal procurement document used to solicit supplier quotations for required goods or services.</t>
                <t t-set="url" t-value="'/my/rfps'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="rfp_list_view_template" name="Portal RFP List">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <h1 class="text-center mb-4">Available RFPs</h1>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>RFP Name</th>
                            <th>Status</th>
                            <th>Required Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rfps" t-as="rfp">
                            <tr>
                                <td><a t-att-href="'/my/rfp/%s' % rfp.id"><t t-esc="rfp.name"/></a></td>
                                <td><t t-esc="rfp.status"/></td>
                                <td><t t-esc="rfp.required_date"/></td>
                                <td>
                                    <a t-att-href="'/my/rfp/%s' % rfp.id" class="btn btn-primary btn-sm">View</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="rfp_form_view_template" name="Portal RFP Form">
        <t t-call="portal.portal_layout">
            <t t-set="title" t-value="'Request for Proposal'"/>

            <div class="container mt-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="text-primary"><t t-esc="rfp.name"/></h1>
                    <span class="badge bg-info fs-5 px-3 py-2"><t t-esc="rfp.status"/></span>
                </div>

                <div class="card shadow-lg p-4 mb-4">
                    <h3 class="text-secondary">RFP Details</h3>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>RFP Reference:</strong>
                            <span class="text-dark fs-5"><t t-esc="rfp.name"/></span>
                        </div>
                        <div class="col-md-6">
                            <strong>Required Date:</strong>
                            <span class="text-dark"><t t-esc="rfp.required_date"/></span>
                        </div>
                        <div class="col-md-6 mt-3">
                            <strong>Reviewer:</strong>
                            <span class="text-dark"><t t-esc="rfp.reviewer_id.name or 'Not Assigned'"/></span>
                        </div>
                        <div class="col-md-6 mt-3">
                            <strong>Approved Supplier:</strong>
                            <span class="text-dark"><t t-esc="rfp.approved_supplier_id.name or 'Pending'"/></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-lg p-4 mb-4">
                    <h3 class="text-secondary">Submit Your Quotation</h3>
                    <form t-attf-action="/my/rfp/{{rfp.id}}/submit_rfq" method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Warranty Period (months)</label>
                                <input type="number" name="warranty_period" class="form-control" required="" placeholder="Enter warranty period"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Expected Delivery Date</label>
                                <input type="date" name="expected_delivery_date" class="form-control" required=""/>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-bold">Terms &amp; Conditions</label>
                            <textarea name="terms_conditions" class="form-control" rows="3" placeholder="Enter any special terms and conditions"></textarea>
                        </div>

                        <div class="table-responsive mt-4">
                            <h4 class="text-secondary">Product Lines</h4>
                            <table class="table table-bordered">
                                <thead class="table-dark text-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Description</th>
                                        <th>Quantity</th>
                                        <th>Unit Price ($)</th>
                                        <th>Delivery Charges ($)</th>
                                        <th>Subtotal ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="rfp.product_line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.product_id.name"/></td>
                                            <td><t t-esc="line.description or 'No Description'"/></td>
                                            <td><t t-esc="line.quantity"/></td>
                                            <td><input type="number" name="price_unit" t-attf-name="price_unit_{{line.id}}" class="form-control"/></td>
                                            <td><input type="number" name="delivery_charge" t-attf-name="delivery_charge_{{line.id}}" class="form-control"/></td>
                                            <td><t t-esc="line.subtotal_price"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-4">Submit RFQ</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>


    <template id="rfq_submit_view_template" name="Portal RFQ Submission">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <h2 class="text-center text-primary">RFQ Submission Status</h2>

                <!-- ✅ Success Message -->
                <t t-if="success_list">
                    <div class="alert alert-success mt-3" role="alert">
                        <h4 class="alert-heading">Success!</h4>
                        <p>Your RFQ has been successfully submitted.</p>
                        <ul>
                            <t t-foreach="success_list" t-as="success">
                                <li><t t-out="success"/></li>
                            </t>
                        </ul>
                        <hr>
                            <p class="mb-0">You will be notified once your quotation is reviewed.</p>
                        </hr>
                    </div>
                </t>

                <!-- ❌ Error Message -->
                <t t-if="error_list">
                    <div class="alert alert-danger mt-3" role="alert">
                        <h4 class="alert-heading">Error!</h4>
                        <p>There was an issue with your submission:</p>
                        <ul>
                            <t t-foreach="error_list" t-as="error">
                                <li><t t-out="error"/></li>
                            </t>
                        </ul>
                        <hr>
                            <p class="mb-0">Please check your inputs and try again.</p>
                        </hr>
                    </div>
                </t>

                <div class="d-flex justify-content-center mt-4">
                    <a href="/my/rfps" class="btn btn-outline-primary">Back to RFPs</a>
                </div>
            </div>
        </t>
    </template>
</odoo>