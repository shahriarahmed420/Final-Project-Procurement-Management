<odoo>
    <record id="email_template_rfq_submission" model="mail.template">
        <field name="name">RFQ Submission Notification</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="email_from">${(object.user_id.email or 'noreply@yourcompany.com')}</field>
        <field name="email_to">${','.join(object.rfp_id.reviewer_id.mapped('email'))}</field>
        <field name="subject">[New RFQ Submitted] ${object.name}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello ${object.rfp_id.reviewer_id.name},</p>
            <p>A new RFQ has been submitted for RFP <strong>${object.rfp_id.name}</strong>.</p>
            <p><strong>Supplier:</strong> ${object.partner_id.name}</p>
            <p><strong>RFQ Total:</strong> ${object.amount_total}</p>
            <p>You can review it by clicking below:</p>
            <p><a href="${object.get_portal_url()}">View RFQ</a></p>
            ]]>
        </field>
    </record>

    <record id="email_template_rfq_recommendation" model="mail.template">
        <field name="name">RFQ Recommendation Notification</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="email_from">${(object.user_id.email or 'noreply@yourcompany.com')}</field>
        <field name="email_to">${','.join(object.rfp_id.approver_id.mapped('email'))}</field>
        <field name="subject">[RFQ Recommended] ${object.name}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello ${object.rfp_id.approver_id.name},</p>
            <p>The RFQ for RFP <strong>${object.rfp_id.name}</strong> has been recommended for approval.</p>
            <p><strong>Recommended Supplier:</strong> ${object.partner_id.name}</p>
            <p><strong>RFQ Total:</strong> ${object.amount_total}</p>
            <p>You can approve or reject this RFQ by clicking below:</p>
            <p><a href="${object.get_portal_url()}">Review RFQ</a></p>
            ]]>
        </field>
    </record>

    <record id="email_template_rfq_approval" model="mail.template">
        <field name="name">RFQ Approval Notification</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="email_from">${(object.user_id.email or 'noreply@yourcompany.com')}</field>
        <field name="email_to">${object.partner_id.email}</field>
        <field name="subject">[RFQ Approved] ${object.name}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello ${object.partner_id.name},</p>
            <p>Congratulations! Your RFQ for RFP <strong>${object.rfp_id.name}</strong> has been approved.</p>
            <p><strong>Final Purchase Order:</strong> ${object.name}</p>
            <p>You can check the order details by clicking below:</p>
            <p><a href="${object.get_portal_url()}">View PO</a></p>
            ]]>
        </field>
    </record>

    <record id="email_template_rfq_rejection" model="mail.template">
        <field name="name">RFQ Rejection Notification</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="email_from">${(object.user_id.email or 'noreply@yourcompany.com')}</field>
        <field name="email_to">${object.partner_id.email}</field>
        <field name="email_cc">${object.rfp_id.reviewer_id.email}</field>
        <field name="subject">[RFQ Rejected] ${object.name}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello ${object.partner_id.name},</p>
            <p>Unfortunately, your RFQ for RFP <strong>${object.rfp_id.name}</strong> has been rejected.</p>
            <p>For more details, please contact the reviewer.</p>
            <p><a href="${object.get_portal_url()}">View RFQ</a></p>
            ]]>
        </field>
    </record>

    <record id="email_template_po_creation" model="mail.template">
        <field name="name">Purchase Order Creation Notification</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="email_from">${(object.user_id.email or 'noreply@yourcompany.com')}</field>
        <field name="email_to">${object.partner_id.email}</field>
        <field name="subject">[New Purchase Order] ${object.name}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello ${object.partner_id.name},</p>
            <p>A new Purchase Order has been generated for your approved RFQ.</p>
            <p><strong>PO Number:</strong> ${object.name}</p>
            <p><strong>Total Amount:</strong> ${object.amount_total}</p>
            <p>You can view the order details here:</p>
            <p><a href="${object.get_portal_url()}">View Purchase Order</a></p>
            ]]>
        </field>
    </record>
</odoo>
